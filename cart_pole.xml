<?xml version="1.0" encoding="UTF-8"?>
<!--
  水平二维移动小车 + 空间倒立摆。
  世界坐标：X、Y 是水平面内两个方向，Z 竖直向上。
  小车可沿 X、Y 独立平移；球铰让摆杆向任意水平方向倾倒。
  SI 单位：长度 m，质量 kg，时间 s，力 N，角速度 rad/s。

  球铰有三个转动自由度：两个倾倒方向，以及绕杆轴的自转。
  因此共有 5 个物理自由度，而非平面模型的 2 个：
    小车 X 平移 + 小车 Y 平移 + 摆杆三个转动。
  姿态用单位四元数表示，避免用欧拉角表示完整空间转动时的奇异性。
  model.nq=6，model.nv=5，model.nu=2。
  data.qpos = [x, y, qw, qx, qy, qz]，四元数顺序为 w、x、y、z。
  data.qvel = [vx, vy, 球铰局部角速度的三个分量]。
  球铰局部角速度不能直接当作世界坐标中的角速度。
  data.ctrl = [Fx, Fy]：两个小车水平推力，均以 N 为单位。

  简化假设：小车是理想 XY 移动平台，保持固定高度和姿态；没有车轮。
  摆杆为均匀刚性圆柱，长度 1 m、质量 0.1 kg，质心距球铰 0.5 m。
  不模拟碰撞、关节摩擦或阻尼；地面仅用于显示，杆倒下时可以穿过地面。
  本文件的 sensor 输出理想测量；真实采样、噪声、量化、延迟需在采样层处理。
-->

<!-- mujoco 是 MJCF 根元素；model 是模型名称，方便在查看器中识别。 -->
<mujoco model="xy_cart_spatial_pole">
  <!--
    compiler：XML 编译设置。
    angle="radian"：XML 中按此设置解释的角度使用弧度。
    inertiafromgeom="true"：根据各 geom 的形状、尺寸、质量自动计算刚体质心和惯量。
    小车和摆杆都不需要另外手写 inertial。
  -->
  <compiler angle="radian" inertiafromgeom="true"/>

  <!--
    option：仿真设置。
    timestep="0.001"：每个物理步 1 ms，即 1000 Hz。
    100 Hz 控制时每 10 步更新推力；200 Hz 控制时每 5 步更新推力。
    gravity="0 0 -9.81"：重力沿 -Z 方向，加速度大小 9.81 m/s^2。
    integrator="implicitfast"：使用快速隐式积分器推进动力学。
    控制周期由程序决定，timestep 本身不等于传感器或控制器的更新周期。
  -->
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

  <!-- default：同类元素继承的公共设置，可由具体元素覆盖。 -->
  <default>
    <!--
      joint：所有关节的默认参数。
      damping="0"：无粘性阻尼；frictionloss="0"：无干摩擦。
      armature="0"：不增加电机转子等折算到关节上的额外惯量。
    -->
    <joint damping="0" frictionloss="0" armature="0"/>
    <!--
      geom：几何体的公共参数。
      contype="0"、conaffinity="0"：关闭所有接触碰撞，关节约束和重力仍然生效。
      rgba：红、绿、蓝、透明度，均取 0 到 1；最后一项为 1 表示不透明。
    -->
    <geom contype="0" conaffinity="0" rgba="0.7 0.7 0.7 1"/>
  </default>

  <!-- asset：可以供几何体引用的纹理、材质等显示资源，不改变物理参数。 -->
  <asset>
    <!--
      texture：地面棋盘纹理，用于观察小车在两个水平方向的位移。
      name：纹理名称；type="2d"：二维纹理；builtin="checker"：生成棋盘格。
      width、height：生成的纹理宽、高，单位像素。
      rgb1、rgb2：两种棋盘格颜色，每项是红、绿、蓝。
    -->
    <texture name="floor_texture" type="2d" builtin="checker"
             width="512" height="512" rgb1="0.86 0.88 0.9" rgb2="0.65 0.69 0.73"/>
    <!--
      material：给地面使用的材质。
      name：材质名称；texture：引用上面的纹理。
      texrepeat="4 4"：纹理在两个纹理坐标方向各重复 4 次。
      texuniform="true"：使用按空间尺寸统一缩放的纹理映射。
    -->
    <material name="floor_material" texture="floor_texture"
              texrepeat="4 4" texuniform="true"/>
  </asset>

  <!--
    statistic：提供默认观察中心和显示尺度，不改变动力学。
    center="0 0 0.6"：默认观察中心；extent="3"：显示的参考尺度，单位 m。
  -->
  <statistic center="0 0 0.6" extent="3"/>

  <!-- worldbody：世界坐标系；直接包含的几何体和相机固定在世界中。 -->
  <worldbody>
    <!--
      light：灯光，仅影响显示。
      name：灯光名称；pos：世界位置；dir：光线传播方向。
      directional="true"：方向光，光线相互平行。
    -->
    <light name="main_light" pos="1 -3 4" dir="-1 3 -4" directional="true"/>

    <!--
      camera：固定相机，便于观察空间运动。
      name="overview"：斜上方总览相机；pos：世界坐标中的位置。
      xyaxes：前 3 项是相机的向右方向，后 3 项是相机的向上方向；
      MuJoCo 会将这些方向归一化。此相机大致朝向 (0, 0, 0.6)。
      fovy="45"：竖直视场角 45 度，始终使用度，不受 compiler.angle 影响。
    -->
    <camera name="overview" pos="3 -4 2.5"
            xyaxes="0.8 0.6 0 -0.228 0.304 1" fovy="45"/>
    <!--
      name="front"：正面相机；pos 位于 -Y 一侧。
      xyaxes：画面向右为世界 +X，向上为 +Z；fovy 为竖直视场角。
    -->
    <camera name="front" pos="0 -4 0.65" xyaxes="1 0 0 0 0 1" fovy="45"/>
    <!--
      name="side"：侧面相机；pos 位于 +X 一侧。
      xyaxes：画面向右为世界 +Y，向上为 +Z；fovy 为竖直视场角。
    -->
    <camera name="side" pos="4 0 0.65" xyaxes="0 1 0 0 0 1" fovy="45"/>
    <!--
      name="top"：俯视相机；pos 位于 +Z 一侧。
      xyaxes：画面向右为世界 +X，向上为 +Y；fovy 为竖直视场角。
    -->
    <camera name="top" pos="0 0 4" xyaxes="1 0 0 0 1 0" fovy="45"/>

    <!--
      geom：地面几何体；name：名称；type="plane"：平面。
      pos：地面位于世界 z=0；size：可视化 X/Y 半尺寸及网格间距，不是厚度。
      material：引用棋盘材质；碰撞已由 default 关闭。
      地面没有物理边界，小车的 XY 位移不受地面可视化尺寸限制。
    -->
    <geom name="ground" type="plane" pos="0 0 0" size="4 4 0.25"
          material="floor_material"/>
    <!--
      X 轴标记：name 为名称；type="capsule" 为胶囊形状。
      fromto：世界坐标中两个端点，指定标记的位置、长度和方向。
      size="0.008"：标记半径 0.008 m；rgba：红色，表示世界 +X。
      这是固定显示元素，不是导轨，不限制小车运动。
    -->
    <geom name="x_axis_marker" type="capsule" fromto="0 0 0.012 1 0 0.012"
          size="0.008" rgba="0.9 0.15 0.15 1"/>
    <!-- Y 轴标记：属性同上；fromto 沿 +Y；rgba 为绿色。 -->
    <geom name="y_axis_marker" type="capsule" fromto="0 0 0.012 0 1 0.012"
          size="0.008" rgba="0.15 0.7 0.2 1"/>

    <!--
      body：小车刚体；name="cart" 为名称。
      pos：两个平移关节位置为零时，小车坐标系原点位于 (0, 0, 0.12) m。
      以下两个 slide 关节让小车能在 XY 平面内平移。
      小车没有 Z 平移和转动关节，因此高度固定，也不会偏航、俯仰或侧倾。
    -->
    <body name="cart" pos="0 0 0.12">
      <!--
        name="cart_x"：X 方向关节名称，供执行器和传感器引用。
        type="slide"：一个平移自由度；axis="1 0 0"：沿小车局部 +X。
        小车姿态固定，因此局部轴与世界轴一致。
        limited="false"：无行程限制；该关节位置存入 qpos[0]，单位 m。
      -->
      <joint name="cart_x" type="slide" axis="1 0 0" limited="false"/>
      <!--
        name="cart_y"：Y 方向关节名称；type="slide"：一个平移自由度。
        axis="0 1 0"：沿 +Y；limited="false"：无行程限制。
        关节按声明顺序存储，该关节位置是 qpos[1]，单位 m。
        两个 slide 在同一个刚体上，不会额外引入中间滑台的质量。
      -->
      <joint name="cart_y" type="slide" axis="0 1 0" limited="false"/>

      <!--
        小车外形和惯性来源。
        name：名称；type="box"：长方体；size：X/Y/Z 三个半尺寸。
        总尺寸为 0.40 x 0.40 x 0.12 m，未写 pos，默认位于小车原点。
        mass="1.0"：小车自身质量 1 kg，不包含子刚体摆杆。
        rgba：蓝色、不透明。
      -->
      <geom name="cart_geom" type="box" size="0.20 0.20 0.06" mass="1.0"
            rgba="0.15 0.45 0.85 1"/>
      <!--
        site：显示球铰位置的标记，不是有质量的刚体，也不会增加惯量。
        name：名称；type="sphere"：球形；pos：相对小车原点的位置。
        size：球的半径；rgba：浅色、不透明。
        该位置与下面 pole 的原点重合，即球铰中心。
      -->
      <site name="pivot_marker" type="sphere" pos="0 0 0.08" size="0.025"
            rgba="0.95 0.95 0.95 1"/>

      <!--
        pole：摆杆刚体，作为 cart 的子刚体随小车一起平移。
        name：刚体名称；pos：相对于小车坐标系，球铰在中心上方 0.08 m。
        初始球铰世界高度为 0.12 + 0.08 = 0.20 m。
      -->
      <body name="pole" pos="0 0 0.08">
        <!--
          name="pole_ball"：球铰名称；type="ball"：三个转动自由度。
          pos="0 0 0"：转动中心位于摆杆坐标系原点。
          limited="false"：不限制球铰转角，杆可向任意方向倾倒和转动。
          球铰不使用 axis，因为它没有单一固定转轴。
          姿态占 qpos[2:6]，单位四元数 [qw, qx, qy, qz]。
          [1, 0, 0, 0] 对应初始姿态：杆沿世界 +Z 竖直向上。
          速度占 qvel[2:5]，是球铰的三个局部角速度分量。
          球铰没有执行器，杆仅通过重力和小车运动间接驱动。
        -->
        <joint name="pole_ball" type="ball" pos="0 0 0" limited="false"/>
        <!--
          均匀圆柱摆杆，圆柱轴线默认沿摆杆局部 Z 轴。
          name：名称；type="cylinder"：圆柱。
          pos="0 0 0.5"：圆柱中心，即质心，距球铰 0.5 m。
          size="0.02 0.5"：半径 0.02 m、半长 0.5 m，所以全长为 1 m。
          下端位于局部 z=0 的球铰，上端位于局部 z=1。
          mass="0.1"：总质量 0.1 kg；rgba：橙色、不透明。
          这是均匀杆，不是无质量杆加杆顶集中质量的模型。
        -->
        <geom name="pole_geom" type="cylinder" pos="0 0 0.5"
              size="0.02 0.5" mass="0.1" rgba="0.95 0.45 0.12 1"/>
        <!--
          杆顶标记，用于观察杆顶在三维空间中的位置。
          site 不增加质量或惯量；name、type、pos、size、rgba 含义同前。
          pos="0 0 1"：相对摆杆原点的杆顶位置。
        -->
        <site name="pole_tip" type="sphere" pos="0 0 1" size="0.03"
              rgba="1 0.8 0.15 1"/>
      </body>
    </body>
  </worldbody>

  <!-- actuator：小车的两个独立推力输入，没有摆杆驱动或车轮驱动。 -->
  <actuator>
    <!--
      motor：直驱执行器，不是位置或速度伺服器。
      name="force_x"：X 推力执行器；joint="cart_x"：作用在 X 平移关节。
      gear="1"：传动倍率为 1，控制值 1 对应 +X 方向 1 N 的力。
      ctrllimited="true"：启用输入限幅；ctrlrange="-20 20"：范围 [-20, 20] N。
      第一个执行器对应 data.ctrl[0]=Fx，正值沿 +X，负值沿 -X。
    -->
    <motor name="force_x" joint="cart_x" gear="1"
           ctrllimited="true" ctrlrange="-20 20"/>
    <!--
      属性含义同上；name="force_y"，joint="cart_y"。
      第二个执行器对应 data.ctrl[1]=Fy，正值沿 +Y，负值沿 -Y。
      两个分量各自限幅到 [-20, 20] N，并不是对合力大小限幅。
    -->
    <motor name="force_y" joint="cart_y" gear="1"
           ctrllimited="true" ctrlrange="-20 20"/>
  </actuator>

  <!--
    sensor：理想传感器，共 14 个标量输出，顺序由声明顺序决定。
    所有 name 都是传感器名称，joint 指定测量的关节。
    每次 mj_forward/mj_step 会计算传感器；控制器应按采样周期取读数。
    若在步进后立即需要与当前 qpos 一致的读数，可先调用 mj_forward。
    下列速度与姿态读数是理想量；模拟实际编码器或 IMU 时要加入测量过程。
  -->
  <sensor>
    <!-- jointpos：cart_x 的位移，sensordata[0]=x，单位 m。 -->
    <jointpos name="cart_position_x" joint="cart_x"/>
    <!-- jointpos：cart_y 的位移，sensordata[1]=y，单位 m。 -->
    <jointpos name="cart_position_y" joint="cart_y"/>
    <!-- jointvel：cart_x 的速度，sensordata[2]=vx，单位 m/s。 -->
    <jointvel name="cart_velocity_x" joint="cart_x"/>
    <!-- jointvel：cart_y 的速度，sensordata[3]=vy，单位 m/s。 -->
    <jointvel name="cart_velocity_y" joint="cart_y"/>
    <!--
      ballquat：球铰姿态四元数，只用于 ball 关节。
      name：名称；joint：球铰名称；sensordata[4:8]=[qw, qx, qy, qz]。
      小车姿态固定，所以此相对于小车的姿态也就是相对于世界的姿态。
      一个四元数的四个分量不是四个独立角度，必须满足单位长度。
    -->
    <ballquat name="pole_orientation" joint="pole_ball"/>
    <!--
      framezaxis：读取指定坐标系 Z 轴在世界中的单位方向向量。
      name：名称；objtype="xbody"：使用刚体坐标系，而非惯性主轴坐标系。
      objname="pole"：摆杆刚体；输出 sensordata[8:11]=[nx, ny, nz]。
      杆沿局部 Z，因此该向量就是从球铰指向杆顶的方向。
      [0, 0, 1] 表示直立；nx>0 向 +X 倾倒，ny>0 向 +Y 倾倒。
      此向量不受绕杆自身轴线的自转影响，适合观察两个倾倒方向。
    -->
    <framezaxis name="pole_direction" objtype="xbody" objname="pole"/>
    <!--
      frameangvel：指定坐标系的世界角速度。
      name：名称；objtype="xbody"、objname="pole"：摆杆刚体坐标系。
      输出 sensordata[11:14]=[wx, wy, wz]，单位 rad/s，表达在世界坐标系。
      与球铰 qvel 的局部角速度表达方式不同，不应直接混用。
    -->
    <frameangvel name="pole_world_angular_velocity" objtype="xbody" objname="pole"/>
  </sensor>

  <!--
    keyframe：保存初始状态；不会在加载时自动选择某一关键帧。
    key 的 name 是状态名称；qpos 按 [x, y, qw, qx, qy, qz] 排列。
    ctrl 按 [Fx, Fy] 排列，单位 N；未写 qvel，恢复时全部速度为零。
    普通加载或 mj_resetData 默认使用 [0, 0, 1, 0, 0, 0]，即精确直立。
  -->
  <keyframe>
    <!-- upright：小车在 XY 原点，摆杆精确直立，两个推力均为零。 -->
    <key name="upright" qpos="0 0 1 0 0 0" ctrl="0 0"/>
    <!--
      initial_tilt：绕水平轴 (-1, 1, 0)/sqrt(2) 转 5 度，杆朝 +X、+Y 的对角方向倾斜。
      四元数计算：[cos(a/2), 轴向量*sin(a/2)]，其中 a=5*pi/180。
      C++ 用 mj_resetDataKeyframe(m, d, 1)，Python 同名函数选索引 1。
      恢复后调用 mj_forward 更新几何位置和传感器。
    -->
    <key name="initial_tilt" qpos="0 0 0.9990482216 -0.0308435646 0.0308435646 0"
         ctrl="0 0"/>
    <!-- tilt_x：绕 +Y 轴转 5 度，杆向 +X 倾斜；其余参数含义同上。 -->
    <key name="tilt_x" qpos="0 0 0.9990482216 0 0.0436193874 0" ctrl="0 0"/>
    <!-- tilt_y：绕 -X 轴转 5 度，杆向 +Y 倾斜；其余参数含义同上。 -->
    <key name="tilt_y" qpos="0 0 0.9990482216 -0.0436193874 0 0" ctrl="0 0"/>
  </keyframe>
</mujoco>
